{
  "manifest_version": 3,
  "name": "AI Screen Time",
  "version": "6.6",
  "description": "Momentumライクなホーム画面 + AI・SNS利用時間トラッカー（時間帯別・曜日別・前期比・セッション統計・年間ヒートマップ・アイドル検出・バッジ・エクスポート）",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://perplexity.ai/*",
    "https://*.perplexity.ai/*",
    "https://grok.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.google.com/*",
    "https://google.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://images.unsplash.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://grok.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.google.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js",
        "break-overlay.js"
      ],
      "css": [
        "widget.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Screen Time"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "break.html"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://grok.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.google.com/*",
        "https://www.youtube.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "120"
}
